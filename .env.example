# FinAgent Unified - Environment Configuration
# COPY THIS FILE TO .env AND FILL IN ACTUAL VALUES
# DO NOT COMMIT .env FILE (it contains sensitive data)

# ==================
# DashScope API (for qwen-agent)
# ==================
DASHSCOPE_API_KEY=

# ==================
# Model Configuration
# ==================
MODEL_NAME=qwen-turbo
MODEL_TYPE=qwen_dashscope
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2000
MODEL_TIMEOUT=30

# ==================
# Redis
# ==================
REDIS_URL=redis://localhost:6379/0

# ==================
# MySQL - FinAgent Database (main database)
# ==================
FINAGENT_DB_HOST=localhost
FINAGENT_DB_PORT=3306
FINAGENT_DB_USER=root
FINAGENT_DB_PASSWORD=
FINAGENT_DB_NAME=finagent
FINAGENT_DB_CHARSET=utf8mb4

# ==================
# MySQL - Stock Database (for investment tools)
# ==================
STOCK_DB_HOST=localhost
STOCK_DB_PORT=3306
STOCK_DB_USER=root
STOCK_DB_PASSWORD=
STOCK_DB_NAME=stock
STOCK_DB_CHARSET=utf8mb4

# ==================
# MySQL - Customer Database (for customer tools)
# ==================
CUSTOMER_DB_HOST=localhost
CUSTOMER_DB_PORT=3306
CUSTOMER_DB_USER=root
CUSTOMER_DB_PASSWORD=
CUSTOMER_DB_NAME=enterprise_credit_clients
CUSTOMER_DB_CHARSET=utf8mb4

# ==================
# Elasticsearch (for insurance tools)
# ==================
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_INDEX_NAME=qwen_agent_docs_vector

# ==================
# Tavily API (for news search)
# ==================
TAVILY_API_KEY=

# ==================
# API Server
# ==================
API_HOST=0.0.0.0
API_PORT=5000
